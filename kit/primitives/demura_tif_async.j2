---
description: |
  Demura TIF SDC Mobile (async) — final demura computation step. Used once at
  the end of the calibration sequence. Templatizes user_name and pattern_setup
  only; everything else is baked in from the reference.
vars:
  - name: user_name
    type: string
    description: User-facing step name (e.g., "Demura Tif SDC Async").
    default: "Demura Tif SDC Async"
    required: false
  - name: pattern_setup_name
    type: string
    description: Pattern setup to use for the demura computation.
  - name: selected
    type: bool
    description: Whether this step is enabled in the sequence.
    default: true
    required: false
---
