---
description: |
  Standard "Register Pixels" measurement step (used 16x for Light Source +
  Synthetic G/R/B at multiple measurement points). Templatizes the 8 fields
  that vary between the 16 instances; the other ~298 fields are baked in.
vars:
  - name: user_name
    type: string
    description: User-facing step name (e.g., "Light Source", "Synthetic G").
  - name: pattern_setup_name
    type: string
    description: Pattern setup to use (e.g., "w1", "W373_DBV650").
  - name: notes
    type: string
    description: Free-text notes shown in the UI (e.g., "Gray373 (ImageCenter)").
  - name: tristimulus
    type: enum
    description: Tristimulus channel (also used for SelectXYZ).
    enum: [TrisX, TrisY, TrisZ]
  - name: current_registration
    type: int
    description: Registration index (1, 2, or 3).
    enum: [1, 2, 3]
    default: 1
    required: false
  - name: static_false_defects_file
    type: string
    description: Filename for static false-defects exclusion list.
    default: "RegisterPixelsFalseDefects.txt"
    required: false
  - name: xml_show_locs_foi_set_id
    type: int
    description: FOI set ID for showing locations in the rendered XML.
    enum: [0, 2]
    default: 0
    required: false
  - name: selected
    type: bool
    description: Whether this step is enabled in the sequence.
    default: true
    required: false
---
